doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width,initial-scale=1")
    meta(name="theme-color" content="#111317")
    link(rel="icon" type="image/png" sizes="430x430" href="/img/rangebook-mark.png")
    link(rel="apple-touch-icon" href="/img/rangebook-mark.png")
    meta(name="description" content="Explore sport-focused coaching, athlete development, and match preparation pathways from RangeBook 10.9.")
    title Courses | RangeBook 10.9
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,500;0,600;0,700;0,800;1,600;1,700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet")
    link(rel="stylesheet" href="/css/style.css")
    script(defer src="/js/script.js")
  body
    header.site-header
      a.brand(href="index.html" aria-label="RangeBook 10.9 home")
        span.brand__mark(aria-hidden="true")
          svg(viewBox="0 0 48 48")
            circle(cx="24" cy="24" r="18")
            circle(cx="24" cy="24" r="10")
            circle(cx="24" cy="24" r="2")
            path(d="M24 1v10m0 26v10M1 24h10m26 0h10")
        span.brand__text
          | RangeBook
          strong 10.9
      button.menu-toggle(type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-navigation")
        span
        span
      nav.primary-nav#primary-navigation(aria-label="Primary")
        a.primary-nav__link(href="index.html") Home
        .nav-item
          .nav-item__top
            a.primary-nav__link(href="platform.html") Platform
            button.nav-dropdown-toggle(type="button" aria-label="Open Platform menu" aria-expanded="false" aria-controls="platform-submenu")
              span(aria-hidden="true") ⌄
          .nav-dropdown__menu#platform-submenu
            a(href="platform.html#dashboard") Athlete dashboard
            a(href="platform.html#planner") Training planner
            a(href="platform.html#analytics") Performance analytics
            a(href="platform.html#archive") Training archive
        .nav-item
          .nav-item__top
            a.primary-nav__link(href="training.html") Training
            button.nav-dropdown-toggle(type="button" aria-label="Open Training menu" aria-expanded="false" aria-controls="training-submenu")
              span(aria-hidden="true") ⌄
          .nav-dropdown__menu#training-submenu
            a(href="training.html#drills") Drills & practice
            a(href="training.html#coaching") Coach connection
            a(href="training.html#mental") Mental precision
            a(href="training.html#matches") Match center
            a(href="training.html#safety") Range safety
        .nav-item
          .nav-item__top
            a.primary-nav__link(href="courses.html" aria-current="page") Courses
            button.nav-dropdown-toggle(type="button" aria-label="Open Courses menu" aria-expanded="false" aria-controls="courses-submenu")
              span(aria-hidden="true") ⌄
          .nav-dropdown__menu#courses-submenu
            a(href="courses.html#sport-disciplines") Sport disciplines
            a(href="courses.html#athlete-development") Athlete development
            a(href="courses.html#private-coaching") Private coaching
        a.primary-nav__link(href="marketplace.html") Marketplace
        a.primary-nav__link(href="about.html") About
        a.primary-nav__link(href="contact.html") Contact
        a.button.button--nav(href="https://play.google.com/store/apps/details?id=com.nimje.shooterspocketdiary" target="_blank" rel="noopener noreferrer")
          | Install the app 
          span(aria-hidden="true") ↗
    main
      section.page-hero
        p.eyebrow
          span.eyebrow__rule
          |  Athlete-first learning
        h1
          | Train with
          br
          em purpose.
        p All coaching is offline and in person. Enquiries are welcome from across India; instructor, authorized venue, schedule, and course duration are confirmed before booking. Course fees are shared directly on enquiry.
      section.services-section#sport-disciplines
        .section-heading.section-heading--center.reveal
          p.eyebrow Sport disciplines
          h2
            | Choose your
            br
            em discipline.
          p These are sport-focused coaching pathways for shooting athletes. Every session is in person at an authorized venue and follows that venue’s supervision and safety rules.
        .service-grid
          article.service-card.reveal
            span.service-card__index 01 / RIFLE SPORT
            h3 Rifle sport coaching
            p In-person coaching for athlete goals, competition preparation, practice planning, and reflective progress tracking.
            p Duration and fee: confirmed on enquiry.
            a.card-link(href="contact.html")
              | Enquire about this course 
              span(aria-hidden="true") ↗
          article.service-card.reveal
            span.service-card__index 02 / PISTOL SPORT
            h3 Pistol sport coaching
            p In-person coaching for sport participation, training consistency, and match-day preparation.
            p Duration and fee: confirmed on enquiry.
            a.card-link(href="contact.html")
              | Enquire about this course 
              span(aria-hidden="true") ↗
          article.service-card.reveal
            span.service-card__index 03 / SHOTGUN SPORT
            h3 Shotgun sport coaching
            p In-person coaching for sport participation, event preparation, and a training diary tailored to your discipline.
            p Duration and fee: confirmed on enquiry.
            a.card-link(href="contact.html")
              | Enquire about this course 
              span(aria-hidden="true") ↗
      section.services-section#athlete-development
        .section-heading.section-heading--center.reveal
          p.eyebrow Beyond one session
          h2
            | Build the whole
            br
            em athlete.
          p Support preparation and progress with coaching conversations, training records, and responsible sport practices.
        .service-grid
          article.service-card.reveal
            span.service-card__index 04 / PERFORMANCE
            h3 Match preparation
            p In-person support for competition goals, event notes, and performance reflection with the RangeBook 10.9 platform.
            p Duration and fee: confirmed on enquiry.
            a.card-link(href="training.html#matches")
              | Explore match center 
              span(aria-hidden="true") ↗
          article.service-card.reveal
            span.service-card__index 05 / MENTAL SKILLS
            h3 Focus and mindset
            p In-person athlete-development sessions focused on concentration, reflection, recovery, and pressure management.
            p Duration and fee: confirmed on enquiry.
            a.card-link(href="training.html#mental")
              | Explore mental training 
              span(aria-hidden="true") ↗
          article.service-card.reveal
            span.service-card__index 06 / SAFETY & WELLBEING
            h3 Venue safety and first response
            p In-person general range-safety and emergency-readiness education. Always follow the venue’s rules and authorized staff.
            p Duration and fee: confirmed on enquiry.
            a.card-link(href="training.html#safety")
              | Review safety reminders 
              span(aria-hidden="true") ↗
      section.coach-section#private-coaching
        .coach-section__image.reveal
          .coach-section__image-frame
            img(src="/img/coach-chat.png" alt="Athlete and coach sharing training feedback in the RangeBook 10.9 app" loading="lazy")
          span.coach-section__stamp
            | ATHLETE
            br
            | + COACH
        .coach-section__copy.reveal
          p.eyebrow Individual support
          h2
            | Coaching that
            br
            em fits your goals.
          p Ask about individual or small-group in-person sport coaching anywhere in India. A suitable instructor, authorized venue, schedule, and duration must be confirmed before booking; no unverified fees or locations are advertised.
          .coach-points
            div
              span 01
              strong Discuss your sport goals
            div
              span 02
              strong Confirm venue and schedule
            div
              span 03
              strong Track progress in your diary
          a.button.button--dark(href="contact.html")
            | Ask about coaching 
            span(aria-hidden="true") ↗
      section.services-section#locations
        .section-heading.section-heading--center.reveal
          p.eyebrow In-person coaching / India
          h2
            | Find a suitable
            br
            em local venue.
          p We welcome enquiries from every state and territory. A coach, authorized venue, and session date must be verified before we confirm availability; we do not claim a course location in every district.
        .service-grid
          article.service-card.reveal
            span.service-card__index PUBLISHED RANGE INFORMATION
            h3 Check established venues
            p NRAI’s introduction page identifies ranges in Delhi, Pune, and Thiruvananthapuram, plus Patiala for shotgun events, as having capacity to conduct international competitions. This is not a course booking or current-availability list.
            a.card-link(href="https://www.thenrai.in/about_us.aspx?link=3" target="_blank" rel="noopener noreferrer")
              | Read NRAI information 
              span(aria-hidden="true") ↗
          article.service-card.reveal
            span.service-card__index STATE / DISTRICT OPTIONS
            h3 Confirm before you travel
            p Ask us to verify the nearest suitable state, district, or club venue, coach availability, discipline, and schedule before making travel plans.
            a.card-link(href="contact.html")
              | Ask about your location 
              span(aria-hidden="true") ↗
      section.services-section
        .section-heading.section-heading--center.reveal
          p.eyebrow Membership
          h2
            | Pick your diary
            br
            em plan.
          p Published RangeBook 10.9 app subscriptions are listed on the Marketplace page. Coaching availability and fees are separate and must be confirmed with the team.
          a.button.button--orange(href="https://play.google.com/store/apps/details?id=com.nimje.shooterspocketdiary" target="_blank" rel="noopener noreferrer")
            | Install the app 
            span(aria-hidden="true") ↗
    footer.site-footer
      .site-footer__main
        .footer-brand
          a.brand.brand--footer(href="index.html")
            span.brand__mark(aria-hidden="true")
              svg(viewBox="0 0 48 48")
                circle(cx="24" cy="24" r="18")
                circle(cx="24" cy="24" r="10")
                circle(cx="24" cy="24" r="2")
                path(d="M24 1v10m0 26v10M1 24h10m26 0h10")
            span.brand__text
              | RangeBook
              strong 10.9
          p A precision training platform for shooting athletes and coaches.
        .footer-links
          p.footer-links__title Explore
          a(href="platform.html") Platform
          a(href="training.html") Training
          a(href="courses.html") Courses
          a(href="marketplace.html") Marketplace
        .footer-links
          p.footer-links__title Contact
          a(href="contact.html#contact") Submit an enquiry
          a(href="https://wa.me/918010368258" target="_blank" rel="noopener noreferrer") WhatsApp
          a(href="contact.html") Contact page
        .footer-links
          p.footer-links__title Information
          a(href="https://shooterspocketdiary.com/privacy-policy" target="_blank" rel="noopener noreferrer") Privacy policy
          a(href="https://shooterspocketdiary.com/terms-and-conditions" target="_blank" rel="noopener noreferrer") Terms & conditions
          a(href="https://shooterspocketdiary.com/refund-policy" target="_blank" rel="noopener noreferrer") Refund policy
          a(href="https://shooterspocketdiary.com/delete-account" target="_blank" rel="noopener noreferrer") Delete account
      .site-footer__bottom
        span
          | © 
          span#current-year
          |  RangeBook 10.9
        span For shooters, by shooters.
        a(href="index.html") Back to home ↑
