doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width,initial-scale=1")
    meta(name="theme-color" content="#111317")
    link(rel="icon" type="image/png" sizes="430x430" href="/img/rangebook-mark.png")
    link(rel="apple-touch-icon" href="/img/rangebook-mark.png")
    meta(name="description" content="Contact RangeBook 10.9 about the platform, training, coaching, or membership.")
    title Contact | RangeBook 10.9
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,500;0,600;0,700;0,800;1,600;1,700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet")
    link(rel="stylesheet" href="/css/style.css")
    script(defer src="/js/script.js")
  body
    header.site-header
      a.brand(href="index.html" aria-label="RangeBook 10.9 home")
        span.brand__mark(aria-hidden="true")
          svg(viewBox="0 0 48 48")
            circle(cx="24" cy="24" r="18")
            circle(cx="24" cy="24" r="10")
            circle(cx="24" cy="24" r="2")
            path(d="M24 1v10m0 26v10M1 24h10m26 0h10")
        span.brand__text
          | RangeBook
          strong 10.9
      button.menu-toggle(type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-navigation")
        span
        span
      nav.primary-nav#primary-navigation(aria-label="Primary")
        a.primary-nav__link(href="index.html") Home
        .nav-item
          .nav-item__top
            a.primary-nav__link(href="platform.html") Platform
            button.nav-dropdown-toggle(type="button" aria-label="Open Platform menu" aria-expanded="false" aria-controls="platform-submenu")
              span(aria-hidden="true") ⌄
          .nav-dropdown__menu#platform-submenu
            a(href="platform.html#dashboard") Athlete dashboard
            a(href="platform.html#planner") Training planner
            a(href="platform.html#analytics") Performance analytics
            a(href="platform.html#archive") Training archive
        .nav-item
          .nav-item__top
            a.primary-nav__link(href="training.html") Training
            button.nav-dropdown-toggle(type="button" aria-label="Open Training menu" aria-expanded="false" aria-controls="training-submenu")
              span(aria-hidden="true") ⌄
          .nav-dropdown__menu#training-submenu
            a(href="training.html#drills") Drills & practice
            a(href="training.html#coaching") Coach connection
            a(href="training.html#mental") Mental precision
            a(href="training.html#matches") Match center
            a(href="training.html#safety") Range safety
        .nav-item
          .nav-item__top
            a.primary-nav__link(href="courses.html") Courses
            button.nav-dropdown-toggle(type="button" aria-label="Open Courses menu" aria-expanded="false" aria-controls="courses-submenu")
              span(aria-hidden="true") ⌄
          .nav-dropdown__menu#courses-submenu
            a(href="courses.html#sport-disciplines") Sport disciplines
            a(href="courses.html#athlete-development") Athlete development
            a(href="courses.html#private-coaching") Private coaching
        a.primary-nav__link(href="marketplace.html") Marketplace
        a.primary-nav__link(href="about.html") About
        a.primary-nav__link(href="contact.html" aria-current="page") Contact
        a.button.button--nav(href="https://play.google.com/store/apps/details?id=com.nimje.shooterspocketdiary" target="_blank" rel="noopener noreferrer")
          | Install the app 
          span(aria-hidden="true") ↗
    main
      section.page-hero
        p.eyebrow
          span.eyebrow__rule
          |  Get in touch
        h1
          | Let’s talk
          br
          em training.
        p Questions about the platform, training, or membership? Reach out using the contact details below.
      section.contact-section#contact
        .contact-section__intro.reveal
          p.eyebrow Contact the team
          h2
            | We’re here to
            br
            em help.
          p For questions about RangeBook 10.9, send us an email or message us on WhatsApp.
          a.button.button--orange(href="https://wa.me/918010368258" target="_blank" rel="noopener noreferrer")
            | Chat with us on WhatsApp 
            span(aria-hidden="true") ↗
        .contact-details.reveal
          .contact-card
            span.contact-card__icon(aria-hidden="true") ✉
            span
              small EMAIL
              strong sayashbende13@gmail.com
          .contact-card
            span.contact-card__icon(aria-hidden="true") ☎
            span
              small WHATSAPP
              strong
                a(href="https://wa.me/918010368258" target="_blank" rel="noopener noreferrer") +91 80103 68258
      section.services-section.contact-follow-section#stay-connected
        .section-heading.section-heading--center.reveal
          p.eyebrow Stay connected
          h2
            | Follow the
            br
            em training journey.
          p Follow RangeBook 10.9 on its verified channels, or send us a message directly.
        .social-links.reveal(aria-label="RangeBook 10.9 social media")
          a.social-link(href="https://www.instagram.com/shooterspocketdiary/" target="_blank" rel="noopener noreferrer")
            span(aria-hidden="true") IG
            |  Instagram 
            span(aria-hidden="true") ↗
          a.social-link(href="https://www.youtube.com/@shooterspocketdiary" target="_blank" rel="noopener noreferrer")
            span(aria-hidden="true") YT
            |  YouTube 
            span(aria-hidden="true") ↗
        .contact-form-wrap.reveal
          div
            p.eyebrow Contact our team
            h3
              | We’d love to
              br
              em hear from you.
            p Submit your enquiry here. Your name, email, and message will be saved for our team so we can follow up with you.
          form.contact-form(data-contact-form)
            label(for="contact-name") Your name
            input#contact-name(name="name" type="text" autocomplete="name" maxlength="120" required)
            label(for="contact-email") Email address
            input#contact-email(name="email" type="email" autocomplete="email" maxlength="254" required)
            label(for="contact-message") Message
            textarea#contact-message(name="message" rows="5" maxlength="5000" required)
            button.button.button--orange(type="submit")
              | Submit enquiry 
              span(aria-hidden="true") ↗
            p.form-status(data-form-status role="status" aria-live="polite")
    footer.site-footer
      .site-footer__main
        .footer-brand
          a.brand.brand--footer(href="index.html")
            span.brand__mark(aria-hidden="true")
              svg(viewBox="0 0 48 48")
                circle(cx="24" cy="24" r="18")
                circle(cx="24" cy="24" r="10")
                circle(cx="24" cy="24" r="2")
                path(d="M24 1v10m0 26v10M1 24h10m26 0h10")
            span.brand__text
              | RangeBook
              strong 10.9
          p A precision training platform for shooting athletes and coaches.
        .footer-links
          p.footer-links__title Explore
          a(href="platform.html") Platform
          a(href="platform.html#showcase") Screens
          a(href="training.html") Training
          a(href="courses.html") Courses
          a(href="marketplace.html") Marketplace
        .footer-links
          p.footer-links__title Contact
          a(href="contact.html#contact") Submit an enquiry
          a(href="https://wa.me/918010368258" target="_blank" rel="noopener noreferrer") WhatsApp
          a(href="contact.html") Contact page
        .footer-links
          p.footer-links__title Information
          a(href="https://shooterspocketdiary.com/privacy-policy" target="_blank" rel="noopener noreferrer") Privacy policy
          a(href="https://shooterspocketdiary.com/terms-and-conditions" target="_blank" rel="noopener noreferrer") Terms & conditions
          a(href="https://shooterspocketdiary.com/refund-policy" target="_blank" rel="noopener noreferrer") Refund policy
          a(href="https://shooterspocketdiary.com/delete-account" target="_blank" rel="noopener noreferrer") Delete account
      .site-footer__bottom
        span
          | © 
          span#current-year
          |  RangeBook 10.9
        span For shooters, by shooters.
        a(href="index.html") Back to home ↑
