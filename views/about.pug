doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width,initial-scale=1")
    meta(name="theme-color" content="#111317")
    link(rel="icon" type="image/png" sizes="430x430" href="/img/rangebook-mark.png")
    link(rel="apple-touch-icon" href="/img/rangebook-mark.png")
    meta(name="description" content="Learn about the RangeBook 10.9 approach to planning, practice, coaching, and performance.")
    title About | RangeBook 10.9
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,500;0,600;0,700;0,800;1,600;1,700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet")
    link(rel="stylesheet" href="/css/style.css")
    script(defer src="/js/script.js")
  body
    header.site-header
      a.brand(href="index.html" aria-label="RangeBook 10.9 home")
        span.brand__mark(aria-hidden="true")
          svg(viewBox="0 0 48 48")
            circle(cx="24" cy="24" r="18")
            circle(cx="24" cy="24" r="10")
            circle(cx="24" cy="24" r="2")
            path(d="M24 1v10m0 26v10M1 24h10m26 0h10")
        span.brand__text
          | RangeBook
          strong 10.9
      button.menu-toggle(type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-navigation")
        span
        span
      nav.primary-nav#primary-navigation(aria-label="Primary")
        a.primary-nav__link(href="index.html") Home
        .nav-item
          .nav-item__top
            a.primary-nav__link(href="platform.html") Platform
            button.nav-dropdown-toggle(type="button" aria-label="Open Platform menu" aria-expanded="false" aria-controls="platform-submenu")
              span(aria-hidden="true") ⌄
          .nav-dropdown__menu#platform-submenu
            a(href="platform.html#dashboard") Athlete dashboard
            a(href="platform.html#planner") Training planner
            a(href="platform.html#analytics") Performance analytics
            a(href="platform.html#archive") Training archive
        .nav-item
          .nav-item__top
            a.primary-nav__link(href="training.html") Training
            button.nav-dropdown-toggle(type="button" aria-label="Open Training menu" aria-expanded="false" aria-controls="training-submenu")
              span(aria-hidden="true") ⌄
          .nav-dropdown__menu#training-submenu
            a(href="training.html#drills") Drills & practice
            a(href="training.html#coaching") Coach connection
            a(href="training.html#mental") Mental precision
            a(href="training.html#matches") Match center
            a(href="training.html#safety") Range safety
        .nav-item
          .nav-item__top
            a.primary-nav__link(href="courses.html") Courses
            button.nav-dropdown-toggle(type="button" aria-label="Open Courses menu" aria-expanded="false" aria-controls="courses-submenu")
              span(aria-hidden="true") ⌄
          .nav-dropdown__menu#courses-submenu
            a(href="courses.html#sport-disciplines") Sport disciplines
            a(href="courses.html#athlete-development") Athlete development
            a(href="courses.html#private-coaching") Private coaching
        a.primary-nav__link(href="marketplace.html") Marketplace
        a.primary-nav__link(href="about.html" aria-current="page") About
        a.primary-nav__link(href="contact.html") Contact
        a.button.button--nav(href="https://play.google.com/store/apps/details?id=com.nimje.shooterspocketdiary" target="_blank" rel="noopener noreferrer")
          | Install the app 
          span(aria-hidden="true") ↗
    main
      section.page-hero
        p.eyebrow
          span.eyebrow__rule
          |  The work behind the result
        h1
          | Precision is built
          br
          em between matches.
        p Good performance is more than a score. It grows from the preparation, reflection, and coaching that connect one session to the next.
      section.intro-section#approach
        .intro-section__index.reveal
          span 01
          span.index-line
          span THE APPROACH
        .intro-section__copy.reveal
          p.eyebrow A clearer training journey
          h2
            | Make every detail
            br
            em count.
          p The plan before a session, the notes after it, a coach’s perspective, and patterns across your results all help shape what comes next. RangeBook 10.9 brings those pieces together in one training space.
          a.text-link(href="platform.html")
            | Explore the platform 
            span(aria-hidden="true") ↗
        .intro-section__aside.reveal
          span.intro-section__target(aria-hidden="true")
            svg(viewBox="0 0 160 160")
              circle(cx="80" cy="80" r="67")
              circle(cx="80" cy="80" r="46")
              circle(cx="80" cy="80" r="23")
              circle(cx="80" cy="80" r="4")
              path(d="M80 0v55m0 50v55M0 80h55m50 0h55")
          p One place for the details that make the next session better.
      section.coach-section#coaching
        .coach-section__image.reveal
          .coach-section__image-frame
            img(src="/img/coach-chat.png" alt="Athlete and coach conversation interface" loading="lazy")
          span.coach-section__stamp
            | ATHLETE
            br
            | + COACH
        .coach-section__copy.reveal
          p.eyebrow A connected coaching approach
          h2
            | Better work,
            br
            em together.
          p Keep coaching feedback connected to the athlete's plan, practice notes, and progress. A shared context helps athletes and coaches keep each session focused and see how the work develops.
          .coach-points
            div
              span 01
              strong Shared training context
            div
              span 02
              strong Feedback tied to practice
            div
              span 03
              strong Progress across sessions
          a.button.button--dark(href="training.html#coaching")
            | Explore coach connection 
            span(aria-hidden="true") ↗
      section.services-section#team
        .section-heading.section-heading--center.reveal
          p.eyebrow The people behind the diary
          h2
            | Built by people
            br
            em who care about the sport.
          p Meet the team members identified by RangeBook 10.9.
        .service-grid.team-grid
          article.service-card.team-card.reveal
            span.team-card__initials(aria-hidden="true") JP
            span.service-card__index FOUNDER & CEO
            h3 Jidaan Patel
            p Founder and CEO of RangeBook 10.9.
          article.service-card.team-card.reveal
            span.team-card__initials(aria-hidden="true") SB
            span.service-card__index INSTRUCTOR
            h3 Sayash Bende
            p Instructor with RangeBook 10.9.
      section.services-section
        .section-heading.section-heading--center.reveal
          p.eyebrow One connected approach
          h2
            | Prepare.
            br
            em Practice. Reflect.
          p Support each part of the journey with tools designed around an athlete’s work.
        .service-grid
          article.service-card.reveal
            span.service-card__index 01 / PREPARE
            h3 Plan with purpose
            p Bring sessions, physical training, recovery, and competitions into a clear schedule.
            a.card-link(href="platform.html#planner")
              | See the planner 
              span(aria-hidden="true") ↗
          article.service-card.reveal
            span.service-card__index 02 / PRACTICE
            h3 Train with focus
            p Use structured drills, coaching feedback, and mental routines to guide your work.
            a.card-link(href="training.html")
              | Explore training 
              span(aria-hidden="true") ↗
          article.service-card.reveal
            span.service-card__index 03 / REFLECT
            h3 Learn from progress
            p Keep results, notes, and performance trends together to inform the next session.
            a.card-link(href="platform.html#analytics")
              | View analytics 
              span(aria-hidden="true") ↗
    footer.site-footer
      .site-footer__main
        .footer-brand
          a.brand.brand--footer(href="index.html")
            span.brand__mark(aria-hidden="true")
              svg(viewBox="0 0 48 48")
                circle(cx="24" cy="24" r="18")
                circle(cx="24" cy="24" r="10")
                circle(cx="24" cy="24" r="2")
                path(d="M24 1v10m0 26v10M1 24h10m26 0h10")
            span.brand__text
              | RangeBook
              strong 10.9
          p A precision training platform for shooting athletes and coaches.
        .footer-links
          p.footer-links__title Explore
          a(href="platform.html") Platform
          a(href="platform.html#showcase") Screens
          a(href="training.html") Training
          a(href="courses.html") Courses
          a(href="marketplace.html") Marketplace
        .footer-links
          p.footer-links__title Contact
          a(href="contact.html#contact") Submit an enquiry
          a(href="https://wa.me/918010368258" target="_blank" rel="noopener noreferrer") WhatsApp
          a(href="contact.html") Contact page
        .footer-links
          p.footer-links__title Information
          a(href="https://shooterspocketdiary.com/privacy-policy" target="_blank" rel="noopener noreferrer") Privacy policy
          a(href="https://shooterspocketdiary.com/terms-and-conditions" target="_blank" rel="noopener noreferrer") Terms & conditions
          a(href="https://shooterspocketdiary.com/refund-policy" target="_blank" rel="noopener noreferrer") Refund policy
          a(href="https://shooterspocketdiary.com/delete-account" target="_blank" rel="noopener noreferrer") Delete account
      .site-footer__bottom
        span
          | © 
          span#current-year
          |  RangeBook 10.9
        span For shooters, by shooters.
        a(href="index.html") Back to home ↑
